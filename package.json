{
  "name": "@axlroden/paperclip-overlord",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Pixel-art god-game control room for Paperclip: watch and command your agents",
  "license": "MIT",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "harness": "node ./dev/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.1106.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
